{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/ruff_after_edit.py\"",
            "timeout": 30,
            "statusMessage": "Форматирование и проверка Python-файлов через Ruff"
          }
        ]
      }
    ]
  }
}
