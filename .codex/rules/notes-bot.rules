# Разрешения, запреты и подтверждения команд вне sandbox; AGENTS.md остаётся обязательным.
# Не заменяет явное поручение пользователя.
# Только точные префиксы: это не файловый запрет для всех инструментов.
prefix_rule(
    pattern = [["ruff", ".venv/bin/ruff"], "check"],
    decision = "allow",
    justification = "Запуск линтера Ruff разрешён.",
    match = [".venv/bin/ruff check .", "ruff check notes_bot tests"],
    not_match = ["ruff format .", "ruff clean"],
)
prefix_rule(
    pattern = [["ruff", ".venv/bin/ruff"], "format", "--check"],
    decision = "allow",
    justification = "Проверка форматирования Ruff без изменения файлов разрешена.",
    match = [".venv/bin/ruff format --check .", "ruff format --check tests"],
    not_match = ["ruff format ."],
)
prefix_rule(
    pattern = [".venv/bin/python", "-m", "pytest"],
    decision = "allow",
    justification = "Запуск тестов pytest в окружении проекта разрешён.",
    match = [".venv/bin/python -m pytest -q", ".venv/bin/python -m pytest tests/test_config.py -q"],
    not_match = [".venv/bin/python -m notes_bot", ".venv/bin/python -c 'print(1)'"],
)
prefix_rule(
    pattern = [["pytest", ".venv/bin/pytest"]],
    decision = "allow",
    justification = "Прямой запуск установленного pytest разрешён.",
    match = ["pytest -q", ".venv/bin/pytest tests -q"],
    not_match = ["uv run pytest"],
)
prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show", "ls-files"]],
    decision = "allow",
    justification = "Просмотр состояния, изменений, истории и списка файлов Git разрешён.",
    match = ["git status --short", "git diff --check", "git log -1", "git show --stat HEAD", "git ls-files"],
    not_match = ["git add .", "git commit -m example", "git push", "git merge main", "git reset --hard", "git clean -fd"],
)
prefix_rule(
    pattern = ["git", "branch", "--show-current"],
    decision = "allow",
    justification = "Просмотр имени текущей ветки разрешён.",
    match = ["git branch --show-current"],
    not_match = ["git branch feature", "git branch -D feature"],
)
prefix_rule(
    pattern = ["cat", "private/demo.txt"],
    decision = "forbidden",
    justification = "Демонстрационный запрет чтения private/demo.txt. Используйте public/demo.txt.",
    match = ["cat private/demo.txt"],
    not_match = ["cat public/demo.txt"],
)
prefix_rule(
    pattern = [["cat", "head", "tail", "less", "more", "bat", "source", "."], [".env", "./.env"]],
    decision = "forbidden",
    justification = "Чтение .env агентом запрещено. Для изучения настроек используйте README.md и notes_bot/config.py.",
    match = ["cat .env", "head ./.env", "tail .env", "less .env", "more .env", "bat .env", "source .env", ". ./.env"],
    not_match = ["cat README.md", "head notes_bot/config.py"],
)
prefix_rule(
    pattern = [["cat", "head", "tail", "less", "more", "bat"], "--", [".env", "./.env"]],
    decision = "forbidden",
    justification = "Чтение .env агентом запрещено. Для изучения настроек используйте README.md и notes_bot/config.py.",
    match = ["cat -- .env", "head -- ./.env", "tail -- .env", "less -- .env", "more -- .env", "bat -- .env"],
    not_match = ["cat -- README.md"],
)
prefix_rule(
    pattern = ["git", ["add", "commit", "push", "merge"]],
    decision = "prompt",
    justification = "Изменение staging, commit, merge и push требуют отдельного поручения пользователя.",
    match = ["git add docs/mvp.md", "git commit -m example", "git push origin develop", "git merge main"],
    not_match = ["git status --short", "git diff", "git log -1"],
)
prefix_rule(
    pattern = ["uv", ["sync", "build"]],
    decision = "prompt",
    justification = "Установка зависимостей и сборка требуют явного разрешения пользователя.",
    match = ["uv sync", "uv build"],
    not_match = ["uv --version"],
)
prefix_rule(
    pattern = ["uv", "run"],
    decision = "prompt",
    justification = "uv run может создать окружение и установить зависимости; проверить разрешение пользователя.",
    match = ["uv run pytest", "uv run python -m notes_bot"],
)
prefix_rule(
    pattern = [["pip", "pip3"], "install"],
    decision = "prompt",
    justification = "Установка пакетов требует явного разрешения пользователя.",
    match = ["pip install aiogram", "pip3 install pytest"],
    not_match = ["pip list"],
)
prefix_rule(
    pattern = [["python", "python3"], "-m", "pip", "install"],
    decision = "prompt",
    justification = "Установка пакетов требует явного разрешения пользователя.",
    match = ["python -m pip install aiogram", "python3 -m pip install pytest"],
)
prefix_rule(
    pattern = [["python", "python3"], "-m", "build"],
    decision = "prompt",
    justification = "Сборка приложения требует явного разрешения пользователя.",
    match = ["python -m build", "python3 -m build"],
)
