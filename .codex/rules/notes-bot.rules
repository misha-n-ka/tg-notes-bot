# Подтверждения команд вне sandbox; AGENTS.md остаётся обязательным.
# Не содержит allow и не заменяет явное поручение пользователя.
prefix_rule(
    pattern = ["git", ["add", "commit", "push", "merge"]],
    decision = "prompt",
    justification = "Изменение staging, commit, merge и push требуют отдельного поручения пользователя.",
    match = ["git add docs/mvp.md", "git commit -m example", "git push origin develop", "git merge main"],
    not_match = ["git status --short", "git diff", "git log -1"],
)
prefix_rule(
    pattern = ["uv", ["sync", "build"]],
    decision = "prompt",
    justification = "Установка зависимостей и сборка требуют явного разрешения пользователя.",
    match = ["uv sync", "uv build"],
    not_match = ["uv --version"],
)
prefix_rule(
    pattern = ["uv", "run"],
    decision = "prompt",
    justification = "uv run может создать окружение и установить зависимости; проверить разрешение пользователя.",
    match = ["uv run pytest", "uv run python -m notes_bot"],
)
prefix_rule(
    pattern = [["pip", "pip3"], "install"],
    decision = "prompt",
    justification = "Установка пакетов требует явного разрешения пользователя.",
    match = ["pip install aiogram", "pip3 install pytest"],
    not_match = ["pip list"],
)
prefix_rule(
    pattern = [["python", "python3"], "-m", "pip", "install"],
    decision = "prompt",
    justification = "Установка пакетов требует явного разрешения пользователя.",
    match = ["python -m pip install aiogram", "python3 -m pip install pytest"],
)
prefix_rule(
    pattern = [["python", "python3"], "-m", "build"],
    decision = "prompt",
    justification = "Сборка приложения требует явного разрешения пользователя.",
    match = ["python -m build", "python3 -m build"],
)
